{
  "name": "shelfed",
  "productName": "Shelfed",
  "version": "0.1.0",
  "description": "A fast, quiet home for your books. Read, organise, convert and send them to your Kindle, on macOS and Windows.",
  "author": "Šimon Vepřek",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/simonveprek/shelfed#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simonveprek/shelfed.git"
  },
  "bugs": {
    "url": "https://github.com/simonveprek/shelfed/issues"
  },
  "keywords": [
    "ebook",
    "library",
    "kindle",
    "epub",
    "reader",
    "electron"
  ],
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:app": "electron-vite build && playwright test",
    "check": "npm run typecheck && npm test",
    "build:azw3": "cd tools/azw3 && GOOS=wasip1 GOARCH=wasm go build -trimpath -ldflags=\"-s -w\" -o ../../resources/azw3.wasm .",
    "postinstall": "node scripts/dev-name.mjs",
    "site": "npm --prefix site run dev",
    "site:build": "npm --prefix site run build",
    "record": "electron-vite build && node scripts/record.mjs"
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.11",
    "mammoth": "^1.13.0",
    "nodemailer": "^10.2.1"
  },
  "devDependencies": {
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-virtual": "^3.14.23",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "fflate": "^0.8.3",
    "foliate-js": "^1.0.1",
    "framer-motion": "^13.5.1",
    "geist": "^1.8.2",
    "happy-dom": "^21.0.4",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zustand": "^5.0.16"
  }
}
