# Netlify's caching for the site. GitHub Pages ignores this file.
# Next's build files have their contents in their names, so they never change.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/media/*
  Cache-Control: public, max-age=604800

/llms.txt
  Content-Type: text/plain; charset=utf-8

/llms-full.txt
  Content-Type: text/plain; charset=utf-8
